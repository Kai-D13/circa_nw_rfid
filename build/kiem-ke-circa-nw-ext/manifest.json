{
  "manifest_version": 3,
  "name": "Kiểm kê Circa ↔ NW",
  "version": "0.1.0",
  "description": "Tạo phiên kiểm kê Nextwaves khi admin tạo phiên kiểm kê Circa; gửi kết quả quét RFID của phiên NW vào phiên Circa.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "scripting", "tabs", "webRequest"],
  "host_permissions": [
    "https://admin.v2.circa.vn/*",
    "https://api.v2.circa.vn/*",
    "https://circa.nextwaves.app/*",
    "https://api-circa.nextwaves.app/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://admin.v2.circa.vn/*"],
      "js": ["watch-circa.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://admin.v2.circa.vn/*"],
      "js": ["config.js", "content-circa.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  }
}
